{
  "name": "vibepersonalize-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter console dev",
    "dev:store": "pnpm --filter demo-nextjs dev",
    "demo:store": "pnpm --filter aurora dev",
    "dev:all": "pnpm -r --parallel dev",
    "seed": "pnpm --filter console seed",
    "test:e2e": "playwright test",
    "benchmark": "tsx benchmarks/run-benchmarks.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.9",
    "happy-dom": "^17.4.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
